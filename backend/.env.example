# Copy to backend/.env (git-ignored) and fill in. Run with (no --reload in live mode):
#   .venv\Scripts\uvicorn app.main:app --env-file .env

# "mock" (default) or "opensky"
FLIGHT_SOURCE=mock

# Needed for FLIGHT_SOURCE=opensky: an API client made on your OpenSky account page.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Credit guard, "normal" preset (values are the defaults; other presets and the reasoning
# are in docs/opensky-credit-guard.md). A global request costs 4 of the 4,000 daily credits.
# OPENSKY_CACHE_TTL_S=90
# OPENSKY_MIN_TTL_S=60
# OPENSKY_MAX_CREDITS_PER_HOUR=200
# OPENSKY_CREDIT_RESERVE=400

# "mock" (default) or "awc" (Aviation Weather Center SIGMETs: free, no key)
WEATHER_SOURCE=mock
# Optional, for WEATHER_SOURCE=awc (values are the defaults)
# WEATHER_USER_AGENT=AirspaceExplorer/0.1
# WEATHER_CACHE_TTL_S=300

# Browser origins allowed to call the API, comma-separated. Set it to the deployed
# frontend's URL; the default is the Vite dev server.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional
# OPENSKY_MAX_FLIGHTS=15000
# Limit to an area: lamin,lomin,lamax,lomax (a box across the date line is not supported)
# OPENSKY_BBOX=35,-30,70,45
